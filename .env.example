# ---------------------------------------------------------------------------
# Copy to .env.local for `vercel dev`, and add the same keys in the Vercel
# dashboard under Settings -> Environment Variables before deploying.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
# The URL and anon key are public by design; they ship to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Never expose this one. Server-side only. It bypasses row-level security,
# which is exactly why the Stripe webhook needs it to record a purchase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe -> Product catalogue -> your one-time product -> price ID
STRIPE_PRICE_ID=price_...

# Public origin, used to build Stripe success/cancel URLs.
# Leave unset on Vercel and it falls back to the request host.
PUBLIC_SITE_URL=http://localhost:3000
